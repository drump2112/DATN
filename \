Dropzone.autoDiscover = false;
var avatarDropzone = null;

$(document).ready(function () {
  function openAddModal() {
    $("#modalTitle").text("Thêm Sản Phẩm");
    $("#productForm").trigger("reset");

    $("#danhMuc").select2({
      dropdownParent: $("#myModal"),
      placeholder: "Chọn danh mục",
      allowClear: true,
      ajax: {
        url: "/admin/category/select2",
        dataType: "json",
        delay: 250,
        data: function (params) {
          return {
            q: params.term, // gửi từ khóa search lên controller
          };
        },

        processResults: function (data) {
          return {
            results: data, //định dạng { id, text }
          };
        },
        cache: true,
      },
    });

    $("#thuongHieu").select2({
      dropdownParent: $("#myModal"),
      placeholder: "Chọn thương hiệu",
      allowClear: true,
      ajax: {
        url: "/admin/brand/select2",
        dataType: "json",
        delay: 250,
        data: function (params) {
          return {
            q: params.term, // gửi từ khóa search lên controller
          };
        },
        processResults: function (data) {
          return {
            results: data, // định dạng { id, text }
          };
        },
        cache: true,
      },
    });
    $("#danhMuc").val(null).trigger("change");
    $("#btnAdd").show();
    $("#btnUpdate").hide();

    $("#myModal").modal("show");
  }

  $("#btnAddProduct").click(function () {
    Swal.fire({
      title: "Xac nhan them san pham",
      icon: "question",
      showCancelButton: true,
      confirmButtonText: "Thêm",
      cancelButtonText: "Hủy",
    });
  });
  window.openAddModal = openAddModal;
});
