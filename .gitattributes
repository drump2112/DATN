# Dùng LF cho shell scripts
*.sh text eol=lf

# Dùng CRLF cho Windows scripts
*.cmd text eol=crlf
*.bat text eol=crlf

# Dùng LF cho các file mã nguồn
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Dùng LF cho file cấu hình
*.md text eol=lf
*.gitignore text eol=lf
